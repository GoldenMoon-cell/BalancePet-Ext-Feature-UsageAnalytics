<Application x:Class="BalancePet.UsageAnalytics.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
  <Application.Resources>

    <!-- ============================================================
         Design tokens, taken from the approved prototype
         (experiments/usage-ui-mockup/App.xaml) rather than invented
         here. The dark analytics palette this plugin already used is
         unchanged; what is added is the design's own semantic set
         (QuotaTrack / QuotaFill / FlowCost / FlowRate / StaleTint)
         plus HairGrid and the row Accent.

         A control either uses a token below or it is a mix of two of
         them. Nothing here is a per-control colour.
         ============================================================ -->

    <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>

    <!-- surfaces -->
    <SolidColorBrush x:Key="PageBrush"        Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SidebarBrush"     Color="#141414"/>
    <SolidColorBrush x:Key="PanelBrush"       Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelAltBrush"    Color="#252525"/>
    <SolidColorBrush x:Key="RaisedBrush"      Color="#252525"/>
    <SolidColorBrush x:Key="PanelHoverBrush"  Color="#303030"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#333333"/>
    <SolidColorBrush x:Key="PanelBorderStrongBrush" Color="#404040"/>

    <!-- type -->
    <SolidColorBrush x:Key="TextBrush"        Color="#F2F2F2"/>
    <SolidColorBrush x:Key="MutedBrush"       Color="#9A9A9A"/>
    <SolidColorBrush x:Key="SubtleBrush"      Color="#686868"/>

    <!-- semantic (this design) -->
    <SolidColorBrush x:Key="QuotaTrackBrush"  Color="#242424"/>
    <SolidColorBrush x:Key="QuotaFillBrush"   Color="#5B8DEF"/>
    <SolidColorBrush x:Key="FlowCostBrush"    Color="#F0A653"/>
    <SolidColorBrush x:Key="FlowRateBrush"    Color="#3DD68C"/>
    <SolidColorBrush x:Key="StaleTintBrush"   Color="#686868"/>
    <SolidColorBrush x:Key="HairGridBrush"    Color="#2E2E2E"/>

    <!-- carried over: chart series and status -->
    <SolidColorBrush x:Key="BlueBrush"        Color="#6EA8FF"/>
    <SolidColorBrush x:Key="PurpleBrush"      Color="#B586FF"/>
    <SolidColorBrush x:Key="OrangeBrush"      Color="#F4B942"/>
    <SolidColorBrush x:Key="RedBrush"         Color="#FF7086"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#3DD68C"/>

    <!-- The live-reading tint. In the prototype this is the *existing* Accent,
         and this plugin's existing AccentBrush is already a live-reading
         colour: every reading drawn in it is one the host reported for the
         current state. It is named separately so the two meanings can never be
         edited as one, and so `AccentBrush` keeps its existing meaning for the
         detail charts and the status words. -->
    <SolidColorBrush x:Key="FlowRateAccentBrush" Color="#3DD68C"/>

    <!-- The task row's own marker: the 2 px bar that grows down the left edge
         while that row opens. Same blue the quota ruler fills with — a hue that
         appears once in a window reads as a mistake, so this is deliberately
         not FlowRate. -->
    <SolidColorBrush x:Key="RowAccentBrush"   Color="#F0A653"/>

    <!--   faces
         UiFontFamily   : body, Chinese and Latin.
         DigitFontFamily: every reading a person compares down a column.
         Monospace is what makes a decimal point sit directly above the one in
         the row above it. Chinese labels are never set in it. -->
    <FontFamily x:Key="UiFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="DigitFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- Every navigation and toolbar glyph keeps the same (2,2)-(12,12) box so
         Stretch="Uniform" normalizes them identically and their optical sizes
         match. Dashboard, History and Folder are filled; Refresh is an open arc
         and must be stroked, never filled. -->
    <Geometry x:Key="BrandMarkGeometry">M 3,5 L 8,5 L 8,7 L 6.2,7 L 11.6,12.4 L 10.1,13.9 L 4.7,8.5 L 4.7,12 L 3,12 Z</Geometry>
    <Geometry x:Key="DashboardIconGeometry">M 2,2 H 6 V 6 H 2 Z M 8,2 H 12 V 6 H 8 Z M 2,8 H 6 V 12 H 2 Z M 8,8 H 12 V 12 H 8 Z</Geometry>
    <Geometry x:Key="HistoryIconGeometry">M 2,2 H 12 V 4 H 2 Z M 2,6 H 12 V 8 H 2 Z M 2,10 H 9 V 12 H 2 Z</Geometry>
    <Geometry x:Key="ProviderIconGeometry">M 7,1.5 L 12.5,7 L 7,12.5 L 1.5,7 Z M 5,7 H 9</Geometry>
    <Geometry x:Key="FolderIconGeometry">M 2,2 H 5.2 L 6.6,3.4 H 12 V 12 H 2 Z</Geometry>
    <Geometry x:Key="MinimizeIconGeometry">M 2,8 H 12</Geometry>
    <Geometry x:Key="CloseIconGeometry">M 3,3 L 11,11 M 11,3 L 3,11</Geometry>
    <Geometry x:Key="RefreshIconGeometry">M 12,6 A 5,5 0 1 0 10.3,10.1 M 12,2.5 V 6 H 8.5</Geometry>
    <Geometry x:Key="ChevronDownGeometry">M 3.2,5.2 L 6.5,8.6 L 9.8,5.2</Geometry>
    <Geometry x:Key="PulseGeometry">M 1.5,6.5 H 4.4 L 6,3 L 8,10 L 9.6,6.5 H 12.5</Geometry>
    <Geometry x:Key="BackGeometry">M 10,2 L 4,8 L 10,14</Geometry>

    <!-- ============================================================
         Type scale. Body 12, section title 13.5, table 11, column head
         10.5, page title 22, and exactly one 26 in the whole window: the
         reading the balance bar exists for. Chinese labels are never
         uppercased and never tracked.
         ============================================================ -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
      <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Any reading: numbers, times, ids, token counts. -->
    <Style x:Key="Digit" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource DigitFontFamily}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
      <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Column head: Chinese, not uppercased, no letter spacing, muted. -->
    <Style x:Key="ColumnHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>

    <!-- The window's only large number. -->
    <Style x:Key="BalanceFigure" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DigitFontFamily}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
      <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--   Alignment is never carried by whitespace alone: a zero-width space
         would collapse, so every figure sits in its own Grid cell.

         Order matters here and is not cosmetic. A BasedOn is a StaticResource
         lookup, resolved as the dictionary is parsed, so a style may only derive
         from one declared above it: derive from one below and the whole Window
         fails to load with "not a valid value for the Foreground property", which
         is what a style that could not be resolved looks like. Digit, FigureCell,
         MutedFigureCell, UnreportedCell, ColumnHead, TableHead is that order. -->
    <Style x:Key="FigureCell" TargetType="TextBlock" BasedOn="{StaticResource Digit}">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MutedFigureCell" TargetType="TextBlock" BasedOn="{StaticResource FigureCell}">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>

    <!-- Text that replaces a figure which was never reported. Never 0. -->
    <Style x:Key="UnreportedCell" TargetType="TextBlock" BasedOn="{StaticResource Digit}">
      <Setter Property="Foreground" Value="{StaticResource StaleTintBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TableHead" TargetType="TextBlock" BasedOn="{StaticResource ColumnHead}">
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Padding" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="LiveFigure" TargetType="TextBlock" BasedOn="{StaticResource Digit}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RowSeparator" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{StaticResource HairGridBrush}"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>

    <!-- ============================================================
         Chrome controls
         ============================================================ -->

    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource RaisedBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource RedBrush}"/>
                <Setter Property="Foreground" Value="#1A1A1A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource FlowRateBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource PanelHoverBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#383838"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#16BFA7"/>
      <Setter Property="Foreground" Value="#101010"/>
      <Setter Property="BorderBrush" Value="#16BFA7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Toolbar button: the 32 px control the page head and the balance bar use. -->
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
    </Style>

    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Foreground" Value="#B9C7DB"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#132A43"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="TrendRangeComboBox" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="MaxDropDownHeight" Value="260"/>
      <Setter Property="ItemContainerStyle" Value="{DynamicResource TrendRangeComboBoxItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="7" SnapsToDevicePixels="True">
                <Grid>
                  <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    TextElement.Foreground="{TemplateBinding Foreground}"/>
                  <Path Data="{StaticResource ChevronDownGeometry}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="5" Stretch="None"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                </Grid>
              </Border>
              <ToggleButton x:Name="DropDownToggle" Background="Transparent" BorderThickness="0" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" CornerRadius="7"/>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom"
                     PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource PanelBorderStrongBrush}"
                        BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource PanelBorderStrongBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource FlowRateBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TrendRangeComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PanelHoverBrush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2C2C2C"/><Setter Property="Foreground" Value="{StaticResource FlowRateBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================================================
         The usage ledger.

         The list is a ListView (the control the plugin binds and
         virtualizes) with every trace of the default item chrome
         removed: no selection fill, no border, no margin, no indent.
         A row draws itself — its own background, its own corners, its
         own left accent bar — because a row that opens has to look
         like it opened, and a template cannot animate a height nobody
         measured. See MainWindow.Ledger.
         ============================================================ -->
    <Style TargetType="ListView">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <!--   Disabled here, because the horizontal bar belongs to the scroller AROUND
           the list rather than to the list's own. A ListView's inner ScrollViewer
           measures its items with the viewport width it had before its vertical
           scrollbar took 10 px, reports an extent 10 px wider than the viewport that
           is left, and therefore shows a horizontal bar for every window including
           the ones whose table fits with room to spare. The outer LedgerScroller
           measures the list at its content width instead, so its bar appears exactly
           when the columns do not fit. See MainWindow.LedgerCardWidth. -->
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
    </Style>

    <Style TargetType="ListViewItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <!--   Left, not Stretch, and that is a layout decision rather than a look.
           A stretched item is as wide as the panel, so the list's extent is the
           panel's width — which is measured before the vertical scrollbar takes
           its 10 px off the viewport. The extent is then permanently 10 px wider
           than the viewport and the horizontal bar is drawn for every window,
           including the ones whose table fits with room to spare. An item sized to
           its own row makes the extent the row's width, so the bar appears exactly
           when the columns do not fit. -->
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AnalyticsScrollThumb" TargetType="Thumb">
      <Setter Property="Background" Value="#3A3A3A"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Margin="3,1" SnapsToDevicePixels="True"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#4A4A4A"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource QuotaFillBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ThumbBorder" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="True">
                <Track.Thumb><Thumb Style="{StaticResource AnalyticsScrollThumb}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="10"/>
          <Setter Property="Width" Value="Auto"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ============================================================
         The hover bubble.

         WPF's default ToolTip is the system's own: a pale box the shell
         draws, with the content as a TextBlock. This window's implicit
         TextBlock style (see the top of this dictionary) sets Foreground
         to TextBrush #F2F2F2 for every TextBlock there is — including
         that one — so a tooltip was near-white text on a near-white
         bubble: a white rectangle with nothing visible in it. That is
         literally what the user reported ("悬浮时显示白色的框。里面没内容").

         Two causes, two fixes. This style gives the bubble the window's
         own dark chrome, so the near-white text is legible on it. And
         MainWindow.Tip refuses to set a tooltip whose text is empty, so
         the other half — an empty string still opening a bubble — cannot
         happen either. A style alone would have left the empty bubble
         looking exactly as empty as before.
         ============================================================ -->
    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderStrongBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" MaxWidth="440">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Background" Value="{StaticResource QuotaTrackBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="5"/>
    </Style>
    <!-- Icon-only navigation button for the 50 px rail.
         The inner Border draws the rounded hover highlight; the outer button
         fills its column so the whole 50 px strip is click-targetable. -->
    <Style x:Key="IconRailButton" TargetType="Button">
      <Setter Property="Width" Value="50"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}"
                    Width="34" Height="34" CornerRadius="7" Margin="8,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{StaticResource RaisedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

  </Application.Resources>
</Application>

